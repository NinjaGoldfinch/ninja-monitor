# Secrets for ninja-ingest, kept in /etc/ninja-ingest/env with owner root
# and mode 0600. install-ingest.sh creates it; `install-ingest.sh --add-agent`,
# `--webhook` and `--heartbeat` fill it in for you. systemd reads it as root
# before starting the service, so the service user never needs to read it.
# Empty values count as unset.

# One bearer token per [[agent]] in config.toml, in the variable that agent's
# token_env names. Generate with: ninja-ingest --new-token
# The same value goes into /etc/ninja-monitor/env on that agent as
# NINJA_MONITOR_PUSH_TOKEN (sudo ./install.sh --push does it).
#NINJA_INGEST_TOKEN_VPS=

# Discord channel webhook: Server Settings > Integrations > Webhooks > Copy Webhook URL.
# Only used when [discord] enabled = true.
NINJA_INGEST_DISCORD_WEBHOOK=

# Heartbeat URL from an external checker such as healthchecks.io.
# Only used when [heartbeat] enabled = true.
NINJA_INGEST_HEARTBEAT_URL=

# Log level: error, warn, info (default), debug, trace.
#NINJA_INGEST_LOG=info
